{
  "name": "react-native-boilerplate",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "start": "expo start",
    "prepare": "lefthook install",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/check-deprecated-apis.mjs && node scripts/check-icons.mjs && jest",
    "theme:contrast": "node scripts/check-contrast.mjs",
    "verify:autolinking": "expo-modules-autolinking verify -v",
    "doctor": "npx expo-doctor@latest && npx expo install --check",
    "check:deprecated": "node scripts/check-deprecated-apis.mjs",
    "check:commits": "node scripts/check-commit-scope.mjs",
    "icons": "python3 scripts/generate-icon-variants.py",
    "check:icons": "node scripts/check-icons.mjs",
    "ota:preview": "node scripts/ota-publish.mjs --channel preview --environment preview",
    "ota:production": "node scripts/ota-publish.mjs --channel production --environment production",
    "ota:forced:preview": "node scripts/ota-publish.mjs --channel preview --environment preview --forced",
    "ota:forced:production": "node scripts/ota-publish.mjs --channel production --environment production --forced",
    "ota:list": "eas update:list --all",
    "ota:health": "eas update:insights",
    "ota:rollback": "eas update:rollback",
    "check:release": "tsx scripts/check-release-config.ts"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.15",
    "@expo/ui": "~57.0.18",
    "@hookform/resolvers": "^5.7.1",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-vector-icons/ionicons": "^13.1.2",
    "@shopify/flash-list": "2.0.2",
    "@shopify/react-native-skia": "2.6.2",
    "@tanstack/react-query": "^5.101.4",
    "expo": "57.0.23",
    "expo-application": "~57.0.3",
    "expo-asset": "~57.0.17",
    "expo-audio": "~57.0.5",
    "expo-blur": "~57.0.3",
    "expo-calendar": "~57.0.4",
    "expo-camera": "~57.0.5",
    "expo-constants": "~57.0.18",
    "expo-contacts": "~57.0.5",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.3",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-local-authentication": "~57.0.3",
    "expo-localization": "~57.0.2",
    "expo-location": "~57.0.18",
    "expo-media-library": "~57.0.5",
    "expo-notifications": "~57.0.19",
    "expo-router": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-tracking-transparency": "~57.0.2",
    "expo-updates": "~57.0.22",
    "lottie-react-native": "~7.3.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.85.0",
    "react-native": "0.86.3",
    "react-native-ease": "^0.8.0",
    "react-native-edge-to-edge": "^1.8.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.36.5",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-unistyles": "^3.3.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "victory-native": "^41.26.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.3",
    "@swmansion/argent": "^0.25.1",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.3",
    "@types/react": "^19.2.18",
    "babel-preset-expo": "~57.0.6",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.5",
    "lefthook": "^2.1.10",
    "prettier": "^3.9.6",
    "react-server-dom-webpack": "~19.2.8",
    "sf-symbols-typescript": "^2.2.0",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@shopify/react-native-skia",
      "lefthook",
      "esbuild",
      "unrs-resolver",
      "tree-sitter",
      "tree-sitter-javascript",
      "tree-sitter-typescript"
    ]
  }
}
