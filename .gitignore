# Agent tooling. Argent (@swmansion/argent) is a devDependency, and its Claude
# Code setup IS committed: .mcp.json, .claude/, .agents/skills/argent-*,
# .argent/{install,config}.json, skills-lock.json. `argent init` also writes
# setup for editors this repo does not standardise on; those stay untracked.
.codex/
.cursor/
.gemini/
.kiro/
.vscode/mcp.json
.zed/
opencode.json
.argent/*
!.argent/install.json
!.argent/config.json
!.argent/flows/
.playwright-mcp/

# Per-developer Claude Code settings.
.claude/settings.local.json

# Working notes for the current session. Never part of the template.
tasks/
