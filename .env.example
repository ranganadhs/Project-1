# Copy to .env.local for local development.
#
# EXPO_PUBLIC_* variables are inlined into the JS bundle and are readable by
# anyone with the binary. Never put a secret here — server credentials belong
# in EAS environment variables, consumed by a backend, not by the app.

# Required
EXPO_PUBLIC_API_URL=https://api.example.com

# Optional — each integration stays inert while its key is absent
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_ANALYTICS_KEY=
